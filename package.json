{
  "name": "betterme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "remotion": "remotion studio src/remotion/index.ts",
    "remotion:render": "remotion render src/remotion/index.ts BetterMeLogo out/betterme-logo.mp4",
    "remotion:still": "remotion still src/remotion/index.ts BetterMeLogo out/betterme-logo.png --frame=45",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm vitest run && pnpm build",
    "test:sync": "vitest run src/lib/sync src/components/app/state-provider-sync.test.tsx src/lib/server/sync-actions.test.ts tests/schema-contract.test.ts",
    "browser": "playwright-cli -s=betterme-qa"
  },
  "dependencies": {
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tooltip": "1.2.11",
    "@remotion/cli": "4.0.484",
    "@remotion/player": "4.0.484",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.110.0",
    "@tanstack/react-query": "5.101.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.562.0",
    "next": "16.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@remotion/eslint-plugin": "4.0.484",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "jsdom": "27.4.0",
    "postcss": "8.5.16",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
